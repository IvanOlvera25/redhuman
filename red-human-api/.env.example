# ============================================================
# Red Human AI — API · Variables de entorno de ejemplo
# Copia este archivo a `.env` y llena las claves que correspondan.
# ============================================================

# --- Base de datos ---
DATABASE_URL=sqlite:///./redhuman.db

# --- API OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- Avatar de Video (Anam) ---
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
ANAM_LLM_ID=
ANAM_MAX_SESION_SEG=900

# --- Frontend URL ---
APP_URL=http://localhost:3000

# --- Administrador inicial ---
ADMIN_EMAIL=admin@redhuman.mx
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=

# --- WhatsApp Oficial (Meta Cloud API) ---
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=redhuman_webhook_verify_token_2026_x89a
WHATSAPP_PUBLIC_NUMBER=

# --- WhatsApp Gateways alternativos ---
WHATSAPP_PROVIDER=
WAHA_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=redhuman

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
